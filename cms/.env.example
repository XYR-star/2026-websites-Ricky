# This is a separate Vercel project and a new v2 database, never the v1 site.
DATABASE_URL=
PAYLOAD_SECRET=
CMS_URL=http://localhost:3000
CMS_READ_TOKEN=
CMS_ADMIN_EMAIL=
# Used only by the local owner:init command. Do not set in Vercel or commit.
CMS_ADMIN_PASSWORD=
SITE_URL=https://www.heyrickishere.com
# Keep deployment disabled until a protected v2 Astro preview is configured.
SITE_DEPLOY_HOOK=
# Configure the complete R2 group together; without credentials uploads stay disabled.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=ricky-site-media
R2_PUBLIC_BASE=https://assets.heyrickishere.com
# Extra legacy public image origins, comma-separated, if needed during import.
LEGACY_MEDIA_ORIGINS=https://assets.heyrickishere.com,https://pub-9f290c4c2d7b479fad35f3c7051d2d9f.r2.dev
