---
import SiteLayout from "../layouts/SiteLayout.astro";
import { projects, projectsPage } from "../data/projects";
---

<SiteLayout title="Projects · Ricky" description="长期项目、研究主题与写作方向">
  <section class="shell page-hero">
    <div class="eyebrow">{projectsPage.hero.eyebrow}</div>
    <h1>{projectsPage.hero.title}</h1>
    <p>{projectsPage.hero.intro}</p>
  </section>

  <section class="shell section">
    <div class="stack">
      {projects.map((project) => (
        <article class="entry">
          <div class="meta-row">
            <span class="tag">{project.status}</span>
          </div>
          <h2 class="entry__title">{project.title}</h2>
          <p>{project.description}</p>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
