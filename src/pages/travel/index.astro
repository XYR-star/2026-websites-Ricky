---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import TravelCard from "../../components/TravelCard.astro";
import { getVisibleTravelPosts } from "../../lib/content";
import "../../styles/column-directory.css";

const posts = getVisibleTravelPosts(await getCollection("travel"));
---

<SiteLayout title="游记 · Ricky" description="关于旅行、行走与城市观察的记录">
  <section class="shell page-hero">
    <div class="eyebrow">Travel Archive</div>
    <h1>游记</h1>
    <p>不是景点清单，而是一路上的光线、步行、气味和那些想要记住的小片刻。</p>
  </section>

  <section class="shell section column-directory" aria-labelledby="travel-directory-title">
    <div class="column-directory__head">
      <h2 id="travel-directory-title">游记目录</h2>
      <nav class="meta-row" aria-label="游记目录导航">
        <a class="section__link" href="/archive">按时间归档</a>
        <a class="section__link" href="/search">搜索</a>
      </nav>
    </div>
    <div class="column-directory__list">
      {posts.length === 0 && <p class="column-directory__empty">目前还没有公开的游记。</p>}
      {posts.map((post) => (
        <TravelCard post={post} />
      ))}
    </div>
  </section>
</SiteLayout>
