---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  getArchiveEntries,
  getSearchIndex,
  getVisiblePosts,
  getVisibleResearchEntries,
  getVisibleTravelPosts,
} from "../lib/content";

const blog = getVisiblePosts(await getCollection("blog"));
const research = getVisibleResearchEntries(await getCollection("research"));
const travel = getVisibleTravelPosts(await getCollection("travel"));
const searchIndex = getSearchIndex(getArchiveEntries({ blog, research, travel }));
const indexJson = JSON.stringify(searchIndex).replace(/</g, "\\u003c");
---

<SiteLayout title="搜索 · Ricky" description="搜索博客、科研进展与游记">
  <section class="shell page-hero">
    <div class="eyebrow">Search</div>
    <h1>搜索</h1>
    <p>按关键词查找文章、研究记录和旅途笔记。支持标题、摘要、标签和正文搜索，也能找到相近的中文词组。</p>
  </section>

  <section class="shell section">
    <div class="search-panel">
      <label class="section-label" for="site-search-input">关键词</label>
      <input
        id="site-search-input"
        class="search-input"
        type="search"
        placeholder="例如：九寨沟 / git / 实验 / 重庆"
        autocomplete="off"
      />
      <p class="markdown-help" id="search-summary" aria-live="polite">输入关键词后，这里会显示匹配结果。</p>
    </div>

    <div class="stack search-results" id="search-results">
      <div class="note-panel">
        <p>可以先试试搜索标题、标签、研究项目名，或者最近写过的一段话。</p>
      </div>
    </div>
  </section>

  <template id="site-search-result">
    <article class="entry">
      <div class="meta-row">
        <time></time>
        <span class="tag"></span>
      </div>
      <h3 class="entry__title"><a></a></h3>
      <p></p>
    </article>
  </template>
  <script is:inline type="application/json" id="site-search-index" set:html={indexJson}></script>
  <script>
    import { findSearchEntries } from "../lib/search.mjs";
    import type { getSearchIndex } from "../lib/content";

    type SearchEntry = ReturnType<typeof getSearchIndex>[number];

    const input = document.querySelector<HTMLInputElement>("#site-search-input");
    const host = document.getElementById("search-results");
    const summary = document.getElementById("search-summary");
    const template = document.querySelector<HTMLTemplateElement>("#site-search-result");
    const index = document.getElementById("site-search-index");

    if (input && host && summary && template && index) {
      const entries = JSON.parse(index.textContent || "[]") as SearchEntry[];
      const dateFormat = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "short", day: "numeric" });
      const typeLabels = { blog: "博客", research: "科研进展", travel: "游记" };

      const renderEmpty = (message: string) => {
        const panel = document.createElement("div");
        const description = document.createElement("p");
        panel.className = "note-panel";
        description.textContent = message;
        panel.append(description);
        host.replaceChildren(panel);
      };

      const renderResult = (entry: SearchEntry) => {
        const result = template.content.cloneNode(true) as DocumentFragment;
        const time = result.querySelector("time")!;
        time.dateTime = entry.date;
        time.textContent = dateFormat.format(new Date(entry.date));
        result.querySelector(".tag")!.textContent = typeLabels[entry.type];
        const link = result.querySelector("a")!;
        link.href = entry.href;
        link.textContent = entry.title;
        result.querySelector("p")!.textContent = entry.description;
        return result;
      };

      let previousQuery: string | undefined;
      const renderResults = () => {
        const query = input.value.trim();
        if (query === previousQuery) return;
        previousQuery = query;

        if (!query) {
          summary.textContent = "输入关键词后，这里会显示匹配结果。";
          renderEmpty("可以先试试搜索标题、标签、研究项目名，或者最近写过的一段话。");
          return;
        }

        const matches = findSearchEntries(entries, query);
        if (matches.length === 0) {
          summary.textContent = "没有找到匹配结果。";
          renderEmpty("这次没有命中内容。你可以换一个关键词，或去归档页按时间浏览。");
          return;
        }

        summary.textContent = `找到 ${matches.length} 条结果。`;
        host.replaceChildren(...matches.map(renderResult));
      };

      let composing = false;
      input.addEventListener("compositionstart", () => { composing = true; });
      input.addEventListener("compositionend", () => {
        composing = false;
        renderResults();
      });
      input.addEventListener("input", () => {
        if (!composing) renderResults();
      });
      renderResults();
    }
  </script>
</SiteLayout>
