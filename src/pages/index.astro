---
import { getCollection } from "astro:content";
import PostCard from "../components/PostCard.astro";
import ResearchCard from "../components/ResearchCard.astro";
import TravelCard from "../components/TravelCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import homepageData from "../data/homepage.json";
import { siteMeta } from "../data/site";
import { validatePageData } from "../lib/page-data.mjs";
import {
  getHomepageLayout,
  getHomepageSectionLabel,
  splitHomepageBody,
  usesMagazineLayout,
  type HomepageAboutNoteSection,
  type HomepageContent,
  type HomepageListSection,
  type HomepageQuoteSection,
  type HomepageSection,
} from "../lib/homepage";
import {
  formatDate,
  getArchiveEntries,
  getVisiblePosts,
  getVisibleResearchEntries,
  getVisibleTravelPosts,
} from "../lib/content";

const homepage = validatePageData("homepage", homepageData) as HomepageContent;
const posts = getVisiblePosts(await getCollection("blog"));
const research = getVisibleResearchEntries(await getCollection("research"));
const travel = getVisibleTravelPosts(await getCollection("travel"));
const sections = getHomepageLayout(homepage);
const legacyLayout = !usesMagazineLayout(homepage);
const siteOrigin = new URL(siteMeta.siteUrl).origin;

function localPath(href: string) {
  const url = new URL(href, siteOrigin);
  if (url.origin !== siteOrigin) return "";
  const pathname = url.pathname.replace(/\/+$/, "");
  try {
    return decodeURI(pathname);
  } catch {
    return pathname;
  }
}

function listLimit(type: HomepageListSection["type"]) {
  const section = sections.find((entry): entry is HomepageListSection => entry.type === type);
  return section ? section.count ?? 3 : 0;
}

const illustratedTravel = travel.filter((post) => post.data.cover);
const coversByPath = new Map(illustratedTravel.map((post) => [localPath(`/travel/${post.slug}`), post]));
const recommendedCover = sections
  .flatMap((section) => section.type === "curatedLinks" ? section.items : [])
  .map((item) => coversByPath.get(localPath(item.href)))
  .find(Boolean);
const cover = sections.find((section) => section.type === "magazineCover");
const contents = sections.find((section) => section.type === "magazineContents");
const fallbackCover = recommendedCover ?? (!legacyLayout || listLimit("travelList") > 0 ? illustratedTravel[0] : undefined);
const lead = cover
  ? illustratedTravel.find((post) => post.slug === cover.travelSlug) ?? fallbackCover
  : undefined;
const leadHref = lead ? `/travel/${lead.slug}` : "";
const continued = contents && (!legacyLayout || lead) ? getArchiveEntries({
  blog: legacyLayout ? posts.slice(0, listLimit("featuredPosts")) : posts,
  research: legacyLayout ? research.slice(0, listLimit("researchList")) : research,
  travel: legacyLayout ? travel.slice(0, listLimit("travelList")) : travel,
}).filter((entry) => entry.href !== leadHref).slice(0, contents.count ?? 2) : [];
const categoryLabels = { blog: "博客", research: "科研进展", travel: "游记" };
const headingSection = sections.find((section) => section.type === "homeIntro" || section.type === "magazineCover" && lead);
const CoverHeading = headingSection?.type === "magazineCover" ? "h1" : "h2";
const IntroHeading = headingSection?.type === "homeIntro" ? "h1" : "h2";
const prioritizeCover = sections[0]?.type === "magazineCover";

const publishedArticlePaths = new Set([
  ...posts.map((entry) => localPath(`/blog/${entry.slug}`)),
  ...research.map((entry) => localPath(`/research/${entry.slug}`)),
  ...travel.map((entry) => localPath(`/travel/${entry.slug}`)),
]);

function recommendationHref(href: string) {
  const path = localPath(href);
  // A recommendation can outlive the article it points to. Keep its copy visible.
  if (/^\/(?:blog|research|travel)\//.test(path) && !publishedArticlePaths.has(path)) return "";
  return href;
}

type RenderGroup =
  | { kind: "featureBand"; quote: HomepageQuoteSection; about: HomepageAboutNoteSection }
  | { kind: "single"; section: HomepageSection };

const renderGroups: RenderGroup[] = [];
for (let index = 0; index < sections.length; index += 1) {
  const current = sections[index];
  const next = sections[index + 1];
  if (current.type === "quote" && next?.type === "aboutNote") {
    renderGroups.push({ kind: "featureBand", quote: current, about: next });
    index += 1;
  } else {
    renderGroups.push({ kind: "single", section: current });
  }
}
---

<SiteLayout title="Ricky · 写作与科研记录" description={siteMeta.description}>
  <div class="magazine">
    {!headingSection && <h1 class="magazine-accessible-title">{homepage.hero.title || siteMeta.title}</h1>}

    {renderGroups.map((group) => {
      if (group.kind === "featureBand") {
        return (
          <section class="shell magazine-section magazine-grid" id={group.quote.id} data-home-section data-section-label={getHomepageSectionLabel(group.quote)}>
            <div class="magazine-note">
              {group.quote.eyebrow && <p class="magazine-kicker">{group.quote.eyebrow}</p>}
              {group.quote.title && <h2>{group.quote.title}</h2>}
              {group.quote.quote && <blockquote>{group.quote.quote}</blockquote>}
              {group.quote.linkLabel && group.quote.linkHref && <a class="magazine-link" href={group.quote.linkHref}>{group.quote.linkLabel}</a>}
            </div>
            <div class="magazine-note" id={group.about.id}>
              {group.about.eyebrow && <p class="magazine-kicker">{group.about.eyebrow}</p>}
              {group.about.title && <h2>{group.about.title}</h2>}
              {splitHomepageBody(group.about.body).map((paragraph) => <p class="magazine-description">{paragraph}</p>)}
              {group.about.linkLabel && group.about.linkHref && <a class="magazine-link" href={group.about.linkHref}>{group.about.linkLabel}</a>}
            </div>
          </section>
        );
      }

      const section = group.section;
      const label = getHomepageSectionLabel(section);

      if (section.type === "magazineCover") {
        if (!lead) return null;
        const title = section.title || lead.data.title;
        return (
          <article class="shell magazine-lead" id={section.id} aria-label={title} data-home-section data-section-label={label}>
            <a class="magazine-lead__media" href={leadHref} aria-label={`阅读${lead.data.title}`}>
              <img
                src={lead.data.cover}
                alt={`${lead.data.title}的封面`}
                loading={prioritizeCover ? undefined : "lazy"}
                fetchpriority={prioritizeCover ? "high" : undefined}
                decoding="async"
              />
            </a>
            <div class="magazine-lead__copy">
              <p class="magazine-kicker">{section.eyebrow || "精选游记"} · <time datetime={lead.data.date.toISOString().slice(0, 10)}>{formatDate(lead.data.date)}</time></p>
              <CoverHeading><a href={leadHref}>{title}</a></CoverHeading>
              {lead.data.description && <p class="magazine-description">{lead.data.description}</p>}
              <a class="magazine-link" href={section.linkHref || leadHref}>{section.linkLabel || "阅读全文"} <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        );
      }

      if (section.type === "magazineContents") {
        if (legacyLayout && continued.length === 0) return null;
        const title = section.title || "继续阅读";
        const linkLabel = section.linkLabel ?? "全部归档";
        const linkHref = section.linkHref ?? "/archive";
        return (
          <section class="shell magazine-continue" id={section.id} aria-label={title} data-home-section data-section-label={label}>
            <div class="magazine-section-head">
              <div>
                {section.eyebrow && <p class="magazine-kicker">{section.eyebrow}</p>}
                <h2>{title}</h2>
              </div>
              {linkLabel && linkHref && <a class="magazine-link" href={linkHref}>{linkLabel} <span aria-hidden="true">↗</span></a>}
            </div>
            {continued.length > 0 ? (
              <div class="magazine-grid">
                {continued.map((entry) => (
                  <article class="magazine-story">
                    <p class="magazine-kicker">{categoryLabels[entry.type]}</p>
                    <h3><a href={entry.href}>{entry.title}</a></h3>
                    {entry.description && <p class="magazine-description">{entry.description}</p>}
                  </article>
                ))}
              </div>
            ) : <p class="magazine-description">文章整理中。</p>}
          </section>
        );
      }

      if (section.type === "homeIntro") {
        return (
          <section class:list={["shell magazine-opening", { "magazine-opening--first": section === sections[0] }]} id={section.id} data-home-section data-section-label={label}>
            {homepage.hero.eyebrow && <p class="magazine-kicker">{homepage.hero.eyebrow}</p>}
            <IntroHeading id={section.id !== homepage.hero.id ? homepage.hero.id : undefined}>{homepage.hero.title || siteMeta.title}</IntroHeading>
            {homepage.hero.intro && <p class="magazine-description">{homepage.hero.intro}</p>}
            {homepage.hero.note && <p class="magazine-description">{homepage.hero.note}</p>}
            {(homepage.hero.primaryLinkLabel && homepage.hero.primaryLinkHref || homepage.hero.secondaryLinkLabel && homepage.hero.secondaryLinkHref) && (
              <div class="magazine-opening__links">
                {homepage.hero.primaryLinkLabel && homepage.hero.primaryLinkHref && <a class="magazine-link" href={homepage.hero.primaryLinkHref}>{homepage.hero.primaryLinkLabel}</a>}
                {homepage.hero.secondaryLinkLabel && homepage.hero.secondaryLinkHref && <a class="magazine-link" href={homepage.hero.secondaryLinkHref}>{homepage.hero.secondaryLinkLabel}</a>}
              </div>
            )}
          </section>
        );
      }

      return (
        <section class="shell magazine-section" id={section.id} data-home-section data-section-label={label}>
          <div class="magazine-section-head">
            <div>
              {section.eyebrow && <p class="magazine-kicker">{section.eyebrow}</p>}
              {section.title && <h2>{section.title}</h2>}
            </div>
            {section.linkLabel && section.linkHref && <a class="magazine-link" href={section.linkHref}>{section.linkLabel} <span aria-hidden="true">↗</span></a>}
          </div>

          {section.type === "featuredPosts" && (posts.length > 0 ? (
            <div class="magazine-grid magazine-cards">{posts.slice(0, section.count ?? 3).map((post) => <PostCard post={post} />)}</div>
          ) : <p class="magazine-description">博客文章整理中。</p>)}

          {section.type === "travelList" && (travel.length > 0 ? (
            <div class="magazine-grid magazine-cards">{travel.slice(0, section.count ?? 3).map((post) => <TravelCard post={post} />)}</div>
          ) : <p class="magazine-description">游记整理中。</p>)}

          {section.type === "researchList" && (research.length > 0 ? (
            <div class="magazine-grid magazine-cards">{research.slice(0, section.count ?? 3).map((item) => <ResearchCard item={item} />)}</div>
          ) : <p class="magazine-description">科研进展整理中。</p>)}

          {"body" in section && <div class="magazine-prose">{splitHomepageBody(section.body).map((paragraph) => <p class="magazine-description">{paragraph}</p>)}</div>}
          {section.type === "quote" && section.quote && <blockquote>{section.quote}</blockquote>}

          {section.type === "curatedLinks" && (
            <div class="magazine-grid">
              {section.items.map((item) => {
                const href = recommendationHref(item.href);
                return (
                  <article class="magazine-story">
                    {item.eyebrow && <p class="magazine-kicker">{item.eyebrow}</p>}
                    {item.title && <h3>{href ? <a href={href}>{item.title}</a> : item.title}</h3>}
                    {item.description && <p class="magazine-description">{item.description}</p>}
                    {href && <a class="magazine-link" href={href}>从这里开始 <span aria-hidden="true">↗</span></a>}
                  </article>
                );
              })}
            </div>
          )}
        </section>
      );
    })}
  </div>
</SiteLayout>

<style>
  .magazine {
    --magazine-serif: "Songti SC", "Noto Serif CJK SC", "STSong", var(--serif);
    color: var(--text);
    padding-block: clamp(1.25rem, 3vw, 2.5rem) 4rem;
  }

  .magazine :is(h1, h2, h3, p, blockquote) { margin: 0; }
  .magazine :is(h1, h2, h3) {
    font-family: var(--magazine-serif);
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .magazine h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }
  .magazine h1, .magazine-lead h2 { font-size: clamp(2rem, 4vw, 3.8rem); letter-spacing: -.035em; }
  .magazine h3 { font-size: clamp(1.18rem, 2vw, 1.55rem); }
  .magazine a:hover { text-decoration: underline; text-underline-offset: .22em; }
  .magazine [data-home-section], .magazine-opening :is(h1, h2) { scroll-margin-top: 7rem; }
  .magazine-accessible-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .magazine-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    background: var(--paper-solid);
    border-block: 1px solid var(--line);
  }
  .magazine-lead__media { position: relative; min-height: clamp(15rem, 30vw, 22rem); background: var(--bg); }
  .magazine-lead__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 47%; }
  .magazine-lead__copy {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: .8rem;
    padding: clamp(1.35rem, 4vw, 3.2rem);
  }
  .magazine-kicker { color: var(--accent); font-size: .83rem; font-weight: 600; letter-spacing: .07em; }
  .magazine-description { color: var(--muted); line-height: 1.72; overflow-wrap: anywhere; }
  .magazine-link { color: var(--accent); font-size: .9rem; font-weight: 600; overflow-wrap: anywhere; }

  .magazine-continue { padding-block: 1.6rem 1.2rem; }
  .magazine-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .45rem 1.4rem;
    margin-bottom: .8rem;
  }
  .magazine-section-head .magazine-kicker { margin-bottom: .3rem; }
  .magazine-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem clamp(1.1rem, 4vw, 2.4rem); }
  .magazine-story { display: grid; align-content: start; justify-items: start; gap: .44rem; padding-top: .75rem; border-top: 1px solid var(--line); }
  .magazine-story > .magazine-link { margin-top: .2rem; }

  .magazine-opening, .magazine-section { border-top: 1px solid var(--line); padding-block: clamp(1.25rem, 4vw, 2.35rem); }
  .magazine-opening { display: grid; justify-items: start; gap: .55rem; margin-top: .7rem; }
  .magazine-opening--first { margin-top: 0; border-top: 0; }
  .magazine-opening__links { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; margin-top: .25rem; }
  .magazine-prose { display: grid; gap: .55rem; max-width: 66ch; }
  .magazine-prose:has(+ .magazine-grid) { margin-bottom: .95rem; }
  .magazine-note { display: grid; align-content: start; justify-items: start; gap: .55rem; }
  .magazine blockquote { border-inline-start: 2px solid var(--line); padding-inline-start: 1rem; color: var(--muted); font: 500 1.25rem/1.65 var(--magazine-serif); white-space: pre-line; }

  .magazine-cards > :global(.card), .magazine-cards > :global(.entry) {
    padding: .85rem 0 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0;
    box-shadow: none;
    background: none;
  }
  .magazine-cards :global(.card__media-link) { margin: 0 0 .75rem; }
  .magazine-cards :global(.card__media) { aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0; }
  .magazine-cards :global(.card__title), .magazine-cards :global(.entry__title) { overflow-wrap: anywhere; }

  @media (max-width: 660px) {
    .magazine-lead, .magazine-grid { grid-template-columns: minmax(0, 1fr); }
    .magazine-lead__media { min-height: 0; aspect-ratio: 16 / 9; }
    .magazine-lead__copy { padding: 1.2rem 1rem 1.4rem; }
  }
</style>
