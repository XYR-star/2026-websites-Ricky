---
import { siteMeta } from "../data/site";

const links = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
  { href: "/research", label: "科研进展" },
  { href: "/travel", label: "游记" },
  { href: "/tracks", label: "轨迹" },
  { href: "/archive", label: "归档" },
  { href: "/search", label: "搜索" },
  { href: "/about", label: "关于我" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <span class="brand__name">{siteMeta.title}</span>
      <span class="brand__tag">Notes, Research and Travel</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={path === link.href ? "page" : undefined}
          class:list={[link.href !== "/" && path.startsWith(`${link.href}/`) && "nav__ancestor"]}
        >{link.label}</a>
      ))}
    </nav>
    <button class="masthead-theme" type="button" data-theme-toggle aria-label="切换黑暗模式" title="切换黑暗模式">
      <span data-theme-icon aria-hidden="true">◐</span>
    </button>
  </div>
</header>
