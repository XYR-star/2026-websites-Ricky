<script is:inline>
  (() => {
    const article = document.querySelector(".prose[data-article-prose]");
    if (!article) return;

    const imageParagraphs = Array.from(article.querySelectorAll("p")).filter((node) => {
      if (node.children.length !== 1) return false;
      const image = node.firstElementChild;
      return image?.tagName === "IMG" && Array.from(node.childNodes).every((child) =>
        child === image || (child.nodeType === Node.TEXT_NODE && !child.textContent.trim()),
      );
    });

    imageParagraphs.forEach((paragraph) => {
      const image = paragraph.querySelector("img");
      if (!image || paragraph.parentElement?.classList.contains("prose-figure")) return;

      const figure = document.createElement("figure");
      figure.className = "prose-figure";

      const captionText = image.getAttribute("title") || image.getAttribute("alt") || "";
      paragraph.replaceWith(figure);
      figure.appendChild(image);

      if (captionText) {
        const caption = document.createElement("figcaption");
        caption.textContent = captionText;
        figure.appendChild(caption);
      }
    });

    const figures = Array.from(article.querySelectorAll(".prose-figure"));
    let group = [];

    const flushGroup = () => {
      if (group.length <= 1) {
        group = [];
        return;
      }

      const gallery = document.createElement("div");
      gallery.className = "prose-gallery";
      gallery.dataset.gallerySize = String(Math.min(group.length, 4));
      group[0].before(gallery);
      group.forEach((item) => gallery.appendChild(item));
      group = [];
    };

    figures.forEach((figure, index) => {
      const previous = figures[index - 1];
      if (!previous) {
        group.push(figure);
        return;
      }

      const isAdjacent = previous.nextElementSibling === figure;
      if (isAdjacent) {
        group.push(figure);
      } else {
        flushGroup();
        group.push(figure);
      }
    });
    flushGroup();

    const lightbox = document.createElement("div");
    lightbox.className = "image-lightbox";
    lightbox.setAttribute("hidden", "");
    lightbox.setAttribute("role", "dialog");
    lightbox.setAttribute("aria-modal", "true");
    lightbox.setAttribute("aria-label", "图片查看");
    lightbox.innerHTML = `
      <button class="image-lightbox__close" type="button" aria-label="关闭图片查看">×</button>
      <div class="image-lightbox__inner">
        <img class="image-lightbox__image" alt="" />
        <p class="image-lightbox__caption"></p>
      </div>
    `;
    document.body.appendChild(lightbox);

    const lightboxImage = lightbox.querySelector(".image-lightbox__image");
    const lightboxCaption = lightbox.querySelector(".image-lightbox__caption");
    const closeButton = lightbox.querySelector(".image-lightbox__close");
    let activeTrigger;

    const closeLightbox = () => {
      lightbox.setAttribute("hidden", "");
      document.body.classList.remove("has-lightbox");
      if (activeTrigger?.isConnected) activeTrigger.focus();
      activeTrigger = undefined;
    };

    closeButton?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (lightbox.hasAttribute("hidden")) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeLightbox();
      } else if (event.key === "Tab") {
        event.preventDefault();
        closeButton?.focus();
      }
    });

    article.querySelectorAll(".prose-figure img").forEach((image) => {
      if (image.closest("a, button")) return;
      const trigger = document.createElement("button");
      trigger.type = "button";
      trigger.className = "image-lightbox-trigger";
      const description = image.getAttribute("title") || image.alt || "";
      trigger.setAttribute("aria-label", description ? "放大图片 " + description : "放大图片");
      trigger.setAttribute("aria-haspopup", "dialog");
      image.before(trigger);
      trigger.appendChild(image);
      image.classList.add("is-lightboxable");
      trigger.addEventListener("click", () => {
        lightboxImage.src = image.currentSrc || image.src;
        lightboxImage.alt = image.alt || "";
        lightboxCaption.textContent = image.getAttribute("title") || image.getAttribute("alt") || "";
        lightbox.removeAttribute("hidden");
        document.body.classList.add("has-lightbox");
        activeTrigger = trigger;
        closeButton?.focus();
      });
    });
  })();
</script>

<style is:global>
  .prose-figure .image-lightbox-trigger {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: zoom-in;
    border-radius: 24px;
  }

  .prose-figure .image-lightbox-trigger:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>
