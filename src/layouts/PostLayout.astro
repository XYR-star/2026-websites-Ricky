---
import SiteLayout from "./SiteLayout.astro";
import StoryLinkCard from "../components/StoryLinkCard.astro";
import ArticleEnhancements from "../components/ArticleEnhancements.astro";
import { formatDate } from "../lib/content";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  cover?: string;
  eyebrow?: string;
  references?: Array<{ label: string; href: string }>;
  previous?: {
    href: string;
    title: string;
    description: string;
  } | null;
  next?: {
    href: string;
    title: string;
    description: string;
  } | null;
  related?: Array<{
    href: string;
    title: string;
    description: string;
    meta?: string;
  }>;
}

const {
  title,
  description,
  date,
  tags = [],
  cover,
  eyebrow = "Essay",
  references = [],
  previous = null,
  next = null,
  related = [],
} = Astro.props;

const coverUrl = cover && URL.canParse(cover, Astro.url) ? new URL(cover, Astro.url) : undefined;
const assetOrigin = coverUrl && [
  "https://assets.heyrickishere.com",
  "https://pub-9f290c4c2d7b479fad35f3c7051d2d9f.r2.dev",
].includes(coverUrl.origin) ? coverUrl.origin : undefined;
---

<SiteLayout title={`${title} · Ricky`} description={description}>
  {assetOrigin && <link slot="head" rel="preconnect" href={assetOrigin} />}
  <article class="magazine-article" aria-labelledby="article-title">
    <header class="shell magazine-article__header">
      <div class="magazine-article__byline">
        <span class="section-label">{eyebrow}</span>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </div>
      <h1 id="article-title">{title}</h1>
      {description.trim() && <p class="magazine-article__lead">{description}</p>}
      {tags.length > 0 && (
        <ul class="magazine-article__tags" aria-label="文章标签">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    {cover && (
      <figure class="shell magazine-article__cover">
        <img src={cover} alt={title} fetchpriority="high" />
      </figure>
    )}
    <div class="prose magazine-article__prose" data-article-prose>
      <slot />
      {references.length > 0 && (
        <section class="magazine-article__references" aria-labelledby="article-references-title">
          <h2 id="article-references-title">资料链接</h2>
          <ul>
            {references.map(({ label, href }) => (
              <li><a href={href} target="_blank" rel="noreferrer">{label}</a></li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
  {(previous || next) && (
    <nav class="shell magazine-followup" aria-labelledby="article-continuation-title">
      <div class="section__head">
        <div>
          <div class="section-label">Continue Reading</div>
          <h2 id="article-continuation-title">继续阅读</h2>
        </div>
      </div>
      <div class="magazine-followup__neighbors">
        {previous ? (
          <StoryLinkCard
            href={previous.href}
            title={previous.title}
            description={previous.description}
            meta="上一篇"
          />
        ) : (
          <div class="entry entry--compact entry--ghost">
            <p>已经到这一条时间线的最新位置。</p>
          </div>
        )}
        {next ? (
          <StoryLinkCard
            href={next.href}
            title={next.title}
            description={next.description}
            meta="下一篇"
          />
        ) : (
          <div class="entry entry--compact entry--ghost">
            <p>这里已经是这一条时间线的最早一篇。</p>
          </div>
        )}
      </div>
    </nav>
  )}
  {related.length > 0 && (
    <section class="shell magazine-followup" aria-labelledby="article-related-title">
      <div class="section__head">
        <div>
          <div class="section-label">Related</div>
          <h2 id="article-related-title">相关推荐</h2>
        </div>
      </div>
      <div class="magazine-followup__related">
        {related.map((item) => (
          <StoryLinkCard
            href={item.href}
            title={item.title}
            description={item.description}
            meta={item.meta}
          />
        ))}
      </div>
    </section>
  )}
  <ArticleEnhancements />
</SiteLayout>

<style>
  .magazine-article__header,
  .magazine-article__cover,
  .magazine-followup {
    max-width: 68rem;
  }

  .magazine-article__header {
    padding-top: clamp(2rem, 6vw, 4.75rem);
  }

  .magazine-article__byline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 0.8rem 0;
    border-block: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
  }

  .magazine-article__header h1 {
    margin: clamp(1.25rem, 4vw, 2.5rem) 0 0;
    font-family: var(--serif);
    font-size: clamp(2.45rem, 6.8vw, 5.35rem);
    font-weight: 500;
    line-height: 1.08;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .magazine-article__lead {
    max-width: 46rem;
    margin: 1.15rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2.1vw, 1.35rem);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .magazine-article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--accent);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  .magazine-article__tags li {
    max-width: 100%;
    padding-inline-start: 0.6rem;
    border-inline-start: 1px solid var(--line-strong);
  }

  .magazine-article__cover {
    margin-block: clamp(1.5rem, 4vw, 2.65rem) 0;
  }

  .magazine-article__cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--line);
    background: var(--bg-soft);
  }

  .magazine-article__prose {
    width: min(calc(100% - 2rem), 44rem);
    padding-block: clamp(2rem, 5vw, 3.8rem) clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .magazine-article__prose :global(p),
  .magazine-article__prose :global(li) {
    color: var(--text);
    font-size: clamp(1.05rem, 1.7vw, 1.15rem);
  }

  .magazine-article__prose :global(h2),
  .magazine-article__prose :global(h3) {
    line-height: 1.25;
  }

  .magazine-article__prose :global(h2) {
    margin-top: 2.4rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
  }

  .magazine-article__prose :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .magazine-article__prose :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--accent);
  }

  .magazine-article__prose :global(pre) {
    overflow-wrap: normal;
  }

  .magazine-article__prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }

  .magazine-article__prose :global(.prose-figure img),
  .magazine-article__prose :global(.image-lightbox-trigger) {
    border-radius: 0;
    box-shadow: none;
  }

  .magazine-article__prose :global(.prose-figure figcaption) {
    padding-top: 0.45rem;
    border-top: 1px solid var(--line);
    line-height: 1.5;
    text-align: start;
  }

  .magazine-article__references {
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .magazine-followup {
    padding-block: 1.25rem clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--line-strong);
  }

  .magazine-followup__neighbors,
  .magazine-followup__related {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem 1.5rem;
  }

  .magazine-followup :global(.entry) {
    min-width: 0;
    padding: 1rem 0;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow-wrap: anywhere;
  }

  .magazine-followup :global(.entry:hover) {
    transform: none;
    background: transparent;
  }

  .magazine-followup :global(.entry__title a:hover),
  .magazine-followup :global(.entry__title a:focus-visible) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
